{"utc": "2026-10-17T12:42:10.397101+00:00", "run": null, "port": 18100, "method": "GET", "path": "/realms/agent-trial/protocol/openid-connect/auth?response_type=code&client_id=https%3A%2F%2Fchatgpt.com%2Foauth%2Fcodex%2Fclient.json&state=LT4O9BvUg_Huo9U6KbCgAA&code_challenge=gsuyV9jfFD6xcpIpAY4VQKe4q-1LkupglynwTapa4iU&code_challenge_method=S256&redirect_uri=http%3A%2F%2F127.0.0.1%3A37827%2Fcallback&scope=openid+profile+phone+email+web-origins+organization+offline_access+basic+roles+acr+microprofile-jwt+address+service_account&resource=http%3A%2F%2F127.0.0.1%3A19000%2Fmcp", "status": 400, "location": null, "body": "<!DOCTYPE html>\n<html class=\"login-pf\" lang=\"en\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n    <title>Sign in to agent-trial</title>\n        <link rel=\"icon\" href=\"/resources/gkxq1/login/keycloak.v2/img/favicon.ico\" />\n        <link href=\"/resources/gkxq1/common/keycloak/vendor/patternfly-v5/patternfly.min.css\" rel=\"stylesheet\" />\n        <link href=\"/resources/gkxq1/common/keycloak/vendor/patternfly-v5/patternfly-addons.css\" rel=\"stylesheet\" />\n        <link href=\"/resources/gkxq1/login/keycloak.v2/css/styles.css\" rel=\"stylesheet\" />\n    <script type=\"importmap\">\n        {\n            \"imports\": {\n                \"rfc4648\": \"/resources/gkxq1/common/keycloak/vendor/rfc4648/rfc4648.js\"\n            }\n        }\n    </script>\n      <script type=\"module\" async blocking=\"render\">\n          const DARK_MODE_CLASS = \"pf-v5-theme-dark\";\n          const mediaQuery = window.matchMedia(\"(prefers-color-scheme: dark)\");\n\n          updateDarkMode(mediaQuery.matches);\n          mediaQuery.addEventListener(\"change\", (event) => updateDarkMode(event.matches));\n\n          function updateDarkMode(isEnabled) {\n            const { classList } = document.documentElement;\n\n            if (isEnabled) {\n              classList.add(DARK_MODE_CLASS);\n            } else {\n              classList.remove(DARK_MODE_CLASS);\n            }\n          }\n      </script>\n    <script type=\"module\" src=\"/resources/gkxq1/login/keycloak.v2/js/passwordVisibility.js\"></script>\n    <script type=\"module\">\n        import { startSessionPolling } from \"/resources/gkxq1/login/keycloak.v2/js/authChecker.js\";\n\n        startSessionPolling(\n            \"/realms/agent-trial/login-actions/restart?skip_logout=true\"\n        );\n    </script>\n    <script type=\"module\">\n        document.addEventListener(\"click\", (event) => {\n            const link = event.target.closest(\"a[data-once-link]\");\n\n            if (!link) {\n                return;\n            }\n\n            if (link.getAttribute(\"aria-disabled\") === \"true\") {\n                event.preventDefault();\n                return;\n            }\n\n            const { disabledClass } = link.dataset;\n\n            if (disabledClass) {\n                link.classList.add(...disabledClass.trim().split(/\\s+/));\n            }\n\n            link.setAttribute(\"role\", \"link\");\n            link.setAttribute(\"aria-disabled\", \"true\");\n        });\n    </script>\n    <script>\n      // Workaround for https://bugzilla.mozilla.org/show_bug.cgi?id=1404468\n      const isFirefox = true;\n    </script>\n</head>\n\n<body id=\"keycloak-bg\" class=\"\" data-page-id=\"login-error\">\n<div class=\"pf-v5-c-login\">\n  <div class=\"pf-v5-c-login__container\">\n    <header id=\"kc-header\" class=\"pf-v5-c-login__header\">\n      <div id=\"kc-header-wrapper\"\n              class=\"pf-v5-c-brand\">agent-trial</div>\n    </header>\n    <main class=\"pf-v5-c-login__main\">\n      <div class=\"pf-v5-c-login__main-header\">\n        <h1 class=\"pf-v5-c-title pf-m-3xl\" id=\"kc-page-title\">        We are sorry...\n</h1>\n      <